# Optional: override the live results feed (defaults to Govmap's public feed).
# NUXT_VOTES_SOURCE_URL=https://elections.govmap.gov.il/data/votes/latest/municipal_data.json
# NUXT_VOTES_CATALOG_URL=https://elections.govmap.gov.il/data/votes/elections.json
# NUXT_VOTES_NEIGHBORHOOD_URL=https://elections.govmap.gov.il/data/votes/latest/neighborhood_data.json

# Enable Nuxt DevTools locally (off by default).
# NUXT_DEVTOOLS=true

# Umami analytics (read at build time; production defaults are in nuxt.config.ts).
# NUXT_UMAMI_HOST=https://um.csp-monitor.com/
# NUXT_UMAMI_ID=71213735-f0d9-4cd1-b61c-4e9ba5b8a134
